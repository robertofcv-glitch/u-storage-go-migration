modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "node scripts/migration-gate.mjs"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["python3", "python311Packages.pandas", "python311Packages.openpyxl", "ffmpeg"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["node", "scripts/migration-gate.mjs"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/migration-gate.mjs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
mockupState = "FULLSTACK"
integrations = ["javascript_database:1.0.0", "google-mail:1.0.0", "javascript_openai_ai_integrations:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
